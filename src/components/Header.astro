---
import { sectionMeta, sectionOrder } from "../lib/blog";

const pathname = Astro.url.pathname;

const nav = [
  { href: "/", label: "首页" },
  { href: "/featured/", label: "推介" },
  ...sectionOrder.map((section) => ({
    href: sectionMeta[section].path,
    label: sectionMeta[section].label,
  })),
  { href: "/about/", label: "关于" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="site-container site-header__inner">
    <a class="brand" href="/" aria-label="Fielddesk 首页">
      <span class="brand__mark">Fielddesk</span>
      <span class="brand__sub">中文研究型内容站</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {nav.map((item) => (
        <a
          class:list={["site-nav__link", isActive(item.href) ? "is-active" : ""]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
