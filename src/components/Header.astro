---
const pathname = Astro.url.pathname;

const nav = [
  { href: "/", label: "首页" },
  { href: "/blog/", label: "文章库" },
  { href: "/blog/#field-notes", label: "栏目" },
  { href: "/blog/#sources", label: "来源" },
];
---

<header class="site-header">
  <div class="site-container site-header__inner">
    <a class="brand" href="/" aria-label="Fielddesk 首页">
      <span class="brand__mark">Fielddesk</span>
      <span class="brand__sub">中文研究型内容站</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {nav.map((item) => (
        <a
          class:list={[
            "site-nav__link",
            pathname === item.href ||
            (item.href === "/blog/" && pathname.startsWith("/blog"))
              ? "is-active"
              : "",
          ]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
