---
import ArticleCard from "../components/ArticleCard.astro";
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import { sectionMeta, sectionOrder, sortPosts } from "../lib/blog";

const posts = sortPosts(await getCollection("blog"));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.id !== featured.id).slice(0, 4);
const columnHighlights = sectionOrder.map((section) => ({
  section,
  post: posts.find((post) => post.data.section === section),
}));
---

<Layout
  title="Fielddesk"
  description="Fielddesk 是一个中文研究型内容站，关注行业观察、公司研究、人物研究和行业专题。"
>
  <section class="site-container hero">
    <div class="hero__intro">
      <p class="eyebrow">Fielddesk</p>
      <h1>把公开材料整理成可以复核的判断</h1>
      <p>
        Fielddesk 关注行业变化、公司动作、人物线索和专题研究。这里不做资讯堆叠，也不做营销式包装，而是把问题、材料和判断放在同一张桌面上。
      </p>
      <div class="hero-actions">
        <a class="text-button" href="/featured/">查看推介</a>
        <a class="text-button" href="/about/">了解方法</a>
      </div>
    </div>
    <div class="hero__feature">
      <div class="section-head">
        <h2>本期重点</h2>
        <a href="/featured/">更多推介</a>
      </div>
      <ArticleCard entry={featured} featured />
    </div>
  </section>

  <section class="page-band">
    <div class="site-container home-grid">
      <div class="section-head">
        <h2>最新更新</h2>
        <p>跨专栏按时间呈现，方便快速进入正在更新的问题。</p>
      </div>
      <div class="latest-list">
        {latestPosts.map((post) => <ArticleCard entry={post} compact />)}
      </div>
    </div>
  </section>

  <section class="page-band">
    <div class="site-container">
      <div class="section-head">
        <h2>专栏</h2>
        <p>四个入口分别负责观察、公司、人物和专题。</p>
      </div>
      <div class="section-overview">
        {sectionOrder.map((section) => {
          const meta = sectionMeta[section];
          return (
            <a
              class="overview-card"
              href={meta.path}
              style={`--section-accent: ${meta.accent};`}
            >
              <div class="overview-card__title">
                <strong>{meta.label}</strong>
                <span>{meta.english}</span>
              </div>
              <p>{meta.summary}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="page-band">
    <div class="site-container home-grid">
      <div class="section-head">
        <h2>各专栏最新</h2>
        <p>每个方向保留一个最新入口，适合按问题长期回看。</p>
      </div>
      <div class="latest-list">
        {columnHighlights.map(({ post }) => post ? <ArticleCard entry={post} compact /> : null)}
      </div>
    </div>
  </section>
</Layout>
