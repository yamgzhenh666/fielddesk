---
import ArticleCard from "../components/ArticleCard.astro";
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import { sectionMeta, sectionOrder, sortPosts } from "../lib/blog";

const posts = sortPosts(await getCollection("blog"));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.id !== featured.id).slice(0, 3);
---

<Layout
  title="Fielddesk"
  description="Fielddesk 是一个中文研究型内容站，关注行业观察、公司研究、人物档案、专题文章和来源整理。"
>
  <section class="site-container hero">
    <div class="hero__intro">
      <p class="eyebrow">Fielddesk</p>
      <h1>中文研究型内容站</h1>
      <p>
        我们把公开材料、行业变化和人物线索放在同一张桌面上看，尽量用克制的语言写清楚判断，不做夸张包装，也不把内容写成日记。
      </p>
      <p class="hero__note">
        首页优先呈现最新更新和固定栏目，帮助读者快速判断这里正在追踪什么、为什么值得继续看。
      </p>
    </div>
    <div class="hero__feature">
      <div class="section-head">
        <h2>最新重点</h2>
        <a href="/blog/">查看全部</a>
      </div>
      <ArticleCard entry={featured} featured />
    </div>
  </section>

  <section class="page-band">
    <div class="site-container home-grid">
      <div class="section-head">
        <h2>最新更新</h2>
        <a href="/blog/">进入文章库</a>
      </div>
      <div class="latest-list">
        {latestPosts.map((post) => <ArticleCard entry={post} compact />)}
      </div>
    </div>
  </section>

  <section class="page-band" id="sections">
    <div class="site-container">
      <div class="section-head">
        <h2>栏目结构</h2>
        <p>每个栏目负责一种固定工作，方便长期积累与回看。</p>
      </div>
      <div class="section-overview">
        {sectionOrder.map((section) => {
          const meta = sectionMeta[section];
          return (
            <a
              class="overview-card"
              href={`/blog/#${section}`}
              style={`--section-accent: ${meta.accent};`}
            >
              <div class="overview-card__title">
                <strong>{meta.label}</strong>
                <span>{meta.subtitle}</span>
              </div>
              <p>{meta.summary}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="page-band">
    <div class="site-container">
      <div class="section-head">
        <h2>编辑方法</h2>
      </div>
      <div class="section-overview">
        <div class="overview-card">
          <div class="overview-card__title">
            <strong>先摆材料，再给判断</strong>
            <span>公开可核验</span>
          </div>
          <p>文章先交代可追溯的信息，再写分析，避免结论先行。</p>
        </div>
        <div class="overview-card">
          <div class="overview-card__title">
            <strong>每篇都保留来源</strong>
            <span>来源清单</span>
          </div>
          <p>重要条目会在正文和独立来源区同时保留，方便继续查证。</p>
        </div>
        <div class="overview-card">
          <div class="overview-card__title">
            <strong>栏目长期跟踪同一问题</strong>
            <span>连续观察</span>
          </div>
          <p>Field Notes 负责观察，Dossiers 和 People 负责沉淀，Briefs 负责收束。</p>
        </div>
        <div class="overview-card">
          <div class="overview-card__title">
            <strong>适合长文阅读</strong>
            <span>清晰排版</span>
          </div>
          <p>移动端和桌面端都保持安静、清楚的层级关系。</p>
        </div>
        <div class="overview-card">
          <div class="overview-card__title">
            <strong>静态发布</strong>
            <span>Markdown 驱动</span>
          </div>
          <p>当前阶段不引入数据库、登录或后台系统，内容完全由 Markdown 管理。</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
